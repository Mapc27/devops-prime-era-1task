# окружение
.venv/
__pycache__/
*.py[cod]

# веса моделей и кэши (скачиваются скриптами)
models/
*.pt
*.onnx
*.gguf
.cache/

# датасеты: сами данные не версионируются, скачиваются скриптами.
# Исключения — небольшие размеченные наборы, составленные в рамках работы:
# без них метрики из отчёта невоспроизводимы.
*/data/*
!*/data/.gitkeep
!*/data/*.csv
!*/data/README.md
# речь синтезирована голосом macOS (say -v Milena): на другой ОС или версии
# голоса записи не воспроизвести, а WER из отчёта посчитан именно по ним
!m3_audio/data/audio/
# тестовые кейсы LLM; make_cases.py пересоздаёт их, но так набор виден сразу
!m5_llm/data/cases.json

# а это скачивается download_data.py, в репозитории не нужен
m1_text/data/public_test.csv

# результаты прогонов
*/out/*
!*/out/.gitkeep

# системное
.DS_Store
